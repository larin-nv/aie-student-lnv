# Порт для запуска API-сервиса
API_PORT=8000

# Хост для запуска API-сервиса
API_HOST=0.0.0.0

# Путь к папке с артефактами (модели)
ARTIFACTS_DIR=artifacts

# Путь к обработанным данным
PROCESSED_DATA_DIR=data/processed

# Лог-уровень (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Режим работы (development, production)
APP_ENV=development